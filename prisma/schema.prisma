generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum JobStatus {
  PENDING
  BIDDING
  BOOKED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  phone         String?   @unique
  role          UserRole  @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customerProfile CustomerProfile?
  providerProfile ProviderProfile?
}

model CustomerProfile {
  id      String @id @default(uuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  jobs    Job[]
}

model ProviderProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  companyName        String
  description        String?
  verificationStatus VerificationStatus @default(PENDING)
  
  vehicles           Vehicle[]
  crewMembers        CrewMember[]
  bids               Bid[]
  jobs               Job[]
}

model Vehicle {
  id                String          @id @default(uuid())
  providerProfileId String
  provider          ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  
  type              String // e.g., 3-ton truck, Pickup
  registration      String
}

model CrewMember {
  id                String          @id @default(uuid())
  providerProfileId String
  provider          ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  
  name              String
  idNumber          String?
}

model Job {
  id                String    @id @default(uuid())
  customerId        String
  customer          CustomerProfile @relation(fields: [customerId], references: [id])
  
  providerId        String?
  provider          ProviderProfile? @relation(fields: [providerId], references: [id])
  
  status            JobStatus @default(PENDING)
  
  pickupLocation    String
  deliveryLocation  String
  moveDate          DateTime
  description       String?
  
  completionPin     String?   // The Job Completion PIN
  
  bids              Bid[]
  payment           EscrowPayment?
  review            Review?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Bid {
  id                String          @id @default(uuid())
  jobId             String
  job               Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  providerId        String
  provider          ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  
  amount            Float
  description       String?
  
  createdAt         DateTime        @default(now())
}

model EscrowPayment {
  id            String   @id @default(uuid())
  jobId         String   @unique
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  amount        Float
  mpesaCode     String?  // Transaction ID from Daraja
  status        String   // e.g., HELD, RELEASED, REFUNDED
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Review {
  id        String   @id @default(uuid())
  jobId     String   @unique
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  rating    Int
  comment   String?
  
  createdAt DateTime @default(now())
}
