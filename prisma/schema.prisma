generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum JobStatus {
  PENDING
  BIDDING
  BOOKED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum EscrowStatus {
  HELD
  RELEASED
  DISPUTED
  REFUNDED
}

enum SubscriptionTier {
  STARTER
  GROWTH
  PRO
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  phone         String?   @unique
  idNumber      String?   @unique
  role          UserRole  @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customerProfile CustomerProfile?
  providerProfile ProviderProfile?
}

model CustomerProfile {
  id      String @id @default(uuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  jobs    Job[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProviderProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  companyName        String
  description        String?
  verificationStatus VerificationStatus @default(PENDING)
  verificationTier   Int                @default(1) // Tiers 1-4
  
  documents          BusinessDocument[]
  vehicles           Vehicle[]
  crewMembers        CrewMember[]
  bids               Bid[]
  jobs               Job[]
  subscription       Subscription?

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model BusinessDocument {
  id                String          @id @default(uuid())
  providerProfileId String
  provider          ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  
  type              String // Business Reg, KRA PIN, Permit
  fileUrl           String
  status            VerificationStatus @default(PENDING)
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Vehicle {
  id                String          @id @default(uuid())
  providerProfileId String
  provider          ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  
  type              String // e.g., 3-ton truck, Pickup
  registration      String
  logbookUrl        String?
  insuranceUrl      String?
  ntsaUrl           String?
  status            VerificationStatus @default(PENDING)
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model CrewMember {
  id                String          @id @default(uuid())
  providerProfileId String
  provider          ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  
  name              String
  idNumber          String?
  photoUrl          String?
  status            VerificationStatus @default(PENDING)
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Job {
  id                String    @id @default(uuid())
  customerId        String
  customer          CustomerProfile @relation(fields: [customerId], references: [id])
  
  providerId        String?
  provider          ProviderProfile? @relation(fields: [providerId], references: [id])
  
  status            JobStatus @default(PENDING)
  
  pickupLocation    String
  deliveryLocation  String
  moveDate          DateTime
  description       String?
  propertyType      String? // e.g., 1 Bedroom, Bedsitter, Office
  specialItems      String? // JSON string or text for special handling items
  photos            String[] // URLs to move photos
  
  completionPin     String?   // The Job Completion PIN (Job Completion Handshake)
  
  bids              Bid[]
  payment           EscrowTransaction?
  review            Review?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Bid {
  id                String          @id @default(uuid())
  jobId             String
  job               Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  providerId        String
  provider          ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  
  amount            Float
  message           String?
  status            String          @default("PENDING") // PENDING, ACCEPTED, REJECTED
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model EscrowTransaction {
  id            String       @id @default(uuid())
  jobId         String       @unique
  job           Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  amount        Float
  mpesaRef      String?      @unique // Transaction ID from Daraja
  status        EscrowStatus @default(HELD)
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Review {
  id               String   @id @default(uuid())
  jobId            String   @unique
  job              Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  // 5-dimension rating
  punctuality      Int
  professionalism  Int
  careOfItems      Int
  communication    Int
  valueForMoney    Int
  
  comment          String?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Subscription {
  id                String           @id @default(uuid())
  providerProfileId String           @unique
  provider          ProviderProfile  @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  
  tier              SubscriptionTier @default(STARTER)
  mpesaRatibaRef    String?          @unique
  active            Boolean          @default(true)
  nextRenewal       DateTime
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}
